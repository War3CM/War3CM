<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Forms/**/*.cs" Link="Forms/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../lang.ini" Link="lang.ini" />
    <None Include="../../lang.ini" Link="lang.ini" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="../../WarcraftPlatformManager.ico" Link="WarcraftPlatformManager.ico" />
    <None Include="../../WarcraftPlatformManager.ico" Link="WarcraftPlatformManager.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
