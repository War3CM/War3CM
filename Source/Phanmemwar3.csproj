<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>Phanmemwar3.Program</StartupObject>
    <AssemblyName>WarcraftPlatformManager</AssemblyName>
    <RootNamespace>Phanmemwar3</RootNamespace>
    <ApplicationIcon>WarcraftPlatformManager.ico</ApplicationIcon>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="lang.ini" />
    <EmbeddedResource Include="WarcraftPlatformManager.ico" />
    <None Update="lang.ini;settings.ini;WarcraftPlatformManager.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <Target Name="ObfuscateRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ObfuscarConfig>$(MSBuildProjectDirectory)\obfuscar.xml</ObfuscarConfig>
    </PropertyGroup>
    <Message Importance="high" Text="[Obfuscar] Obfuscating $(TargetDir)$(TargetFileName)..." />
    <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(ObfuscarConfig)&quot;" WorkingDirectory="$(TargetDir)" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\$(TargetFileName)" DestinationFiles="$(TargetDir)$(TargetFileName)" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\$(TargetFileName)" DestinationFiles="$(IntermediateOutputPath)$(TargetFileName)" />
    <Message Importance="high" Text="[Obfuscar] Obfuscated assembly successfully deployed to bundle pipeline." />
  </Target>

</Project>
